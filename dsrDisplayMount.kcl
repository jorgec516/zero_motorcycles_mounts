// =====================================================================
// Zero DSR Display Mount — Rev R
// =====================================================================
// CHANGES FROM REV Q:
//
// PART 1 — WIRE NOTCH (NEW, REVISED)
// Added a half-round notch in the bottom edge of the base plate for
// the main display wire to pass through. Sized from the wire's
// circumference:
//   wireDiameter = circumference / π = 28mm / 3.14159 = 8.913mm
// A 0.3mm clearance allowance is added on top of that for a snug
// (not loose, not force-fit) assembly fit, giving a finished notch
// diameter of 9.2mm. If you find that too tight/loose once you test
// fit actual wire+insulation, tune wireClearance below and the
// notch diameter recalculates automatically.
//
// REVISED APPROACH — the first pass cut this notch as a separate
// boolean subtract (a cylinder tangent to the bottom edge, subtracted
// from baseFillet008). That failed with:
//   "The Zoo engine cannot handle this 3D subtraction yet."
// Root cause: the cutting cylinder's flat diameter sat exactly
// coincident with the plate's flat bottom face along the full plate
// thickness — a degenerate/tangent condition boolean kernels commonly
// can't resolve.
//
// Fix: the notch is now built directly into the base profile itself
// as a three-point arc segment (bottomLeft -> wireNotch -> bottomRight)
// replacing the old single straight "bottom" line. It becomes part of
// ONE clean extrusion with no secondary boolean required, so there's
// no tangent face for the kernel to trip over. This is also just more
// correct CAD practice — notches that live on a part's outer boundary
// belong in the sketch, not bolted on afterward with a boolean.
//
// PART 2 — POD/FLANGE MOUNTING HOLES (UPDATED)
// Diameter increased from 5.5mm -> 6.5mm, sized as a standard
// clearance hole for an M6 (6mm) bolt.
// Cutter depth increased from (t + 4mm = 7mm) -> 18mm to clear the
// full 18mm bolt length called out in the spec.
// Hole spacing: spec calls for 65mm center-to-center — this already
// matches the existing armSpacing = 65mm parameter that positions
// the two arms, so no spacing change was needed; confirmed and left
// as-is.
//
// Material: 3mm 5052-H32 Aluminum
// =====================================================================

@settings(kclVersion = 2.0, defaultLengthUnit = mm)

// =====================================================================
// PARAMETERS
// =====================================================================

t = 3mm

plateWidth = 150mm
plateLength = 70mm

cornerCut = 15mm

filletRadius = 1.5mm

// Mount holes (base plate to vehicle)
mountHoleDia = 5.5mm
mountHoleSpacing = 80mm
mountHoleX = mountHoleSpacing / 2
mountHoleY = 45mm

// Ignition clearance
ignitionFrameTop = 50mm
ignitionFrameBottom = 105mm
ignitionFrameDepth = 30mm
ignitionGap = 2mm

notchTopWidth = ignitionFrameTop + ignitionGap * 2
notchBottomWidth = ignitionFrameBottom + ignitionGap * 2
notchDepth = ignitionFrameDepth + ignitionGap

// Wire pass-through notch (bottom edge of base plate) — NEW
wireCircumference = 28mm
wireDiameter = 8.913mm // = wireCircumference / π (28 / 3.14159)
wireClearance = 0.3mm // allowance for a snug (not loose) fit
wireNotchDia = 9.2mm // = wireDiameter + wireClearance

// Pod/flange mounting holes (display bracket to arms) — UPDATED
podHoleDia = 6.5mm // was 5.5mm; clearance hole for M6 bolt
podHoleLength = 18mm // was t + 4mm; matches 18mm bolt length

// =====================================================================
// CALCULATIONS
// =====================================================================


halfW = plateWidth / 2
notchHalf = notchBottomWidth / 2
notchInner = notchTopWidth / 2
notchApexY = plateLength - notchDepth

// =====================================================================
// BASE SKETCH
// =====================================================================


baseSketch = sketch(on = XY) {
  bottomLeft = line(start = [-halfW, 0mm], end = [-wireNotchDia / 2, 0mm])

  // Half-round wire notch, using solver::arc(start, end, center).
  // solver::arc always sweeps COUNTERCLOCKWISE from start to end, so
  // to bulge the notch UP into the material (not down off the edge)
  // the right-hand point (r, 0) must be passed as `start` and the
  // left-hand point (-r, 0) as `end` — CCW from angle 0° to 180°
  // passes through 90° (the top of the bump). Passing them the other
  // way around would sweep the bottom of the circle instead and cut
  // the notch outward off the plate.
  //
  // Because of that swap, the coincident wiring below is deliberately
  // "crossed": wireNotch.end (the -r,0 point) mates with bottomLeft,
  // and wireNotch.start (the r,0 point) mates with bottomRight.
  wireNotch = arc(
    start = [wireNotchDia / 2, 0mm],
    end = [-wireNotchDia / 2, 0mm],
    center = [0mm, 0mm],
  )

  bottomRight = line(start = [wireNotchDia / 2, 0mm], end = [halfW, 0mm])

  rightSide = line(start = [halfW, 0mm], end = [halfW, plateLength - cornerCut])

  rightChamfer = line(start = [halfW, plateLength - cornerCut], end = [halfW - cornerCut, plateLength])

  topRight = line(start = [halfW - cornerCut, plateLength], end = [notchHalf, plateLength])

  ignitionRight = line(start = [notchHalf, plateLength], end = [notchInner, notchApexY])

  ignitionCenter = line(start = [notchInner, notchApexY], end = [-notchInner, notchApexY])

  ignitionLeft = line(start = [-notchInner, notchApexY], end = [-notchHalf, plateLength])

  topLeft = line(start = [-notchHalf, plateLength], end = [-halfW + cornerCut, plateLength])

  leftChamfer = line(start = [-halfW + cornerCut, plateLength], end = [-halfW, plateLength - cornerCut])

  leftSide = line(start = [-halfW, plateLength - cornerCut], end = [-halfW, 0mm])

  coincident([bottomLeft.end, wireNotch.end])
  coincident([wireNotch.start, bottomRight.start])
  coincident([bottomRight.end, rightSide.start])
  coincident([rightSide.end, rightChamfer.start])
  coincident([rightChamfer.end, topRight.start])
  coincident([topRight.end, ignitionRight.start])
  coincident([
    ignitionRight.end,
    ignitionCenter.start
  ])
  coincident([ignitionCenter.end, ignitionLeft.start])
  coincident([ignitionLeft.end, topLeft.start])
  coincident([topLeft.end, leftChamfer.start])
  coincident([leftChamfer.end, leftSide.start])
  coincident([leftSide.end, bottomLeft.start])
}

// =====================================================================
// BASE EXTRUSION
// =====================================================================


baseRegion = region(point = [0mm, 10mm], sketch = baseSketch)

baseSolid = extrude(baseRegion, length = t)

// =====================================================================
// MOUNT HOLE CUTTERS
// =====================================================================


leftHoleSketch = sketch(on = XY) {
  leftCircle = circle(
    start = [
      -mountHoleX + mountHoleDia / 2,
      mountHoleY
    ],
    center = [-mountHoleX, mountHoleY],
  )
}

rightHoleSketch = sketch(on = XY) {
  rightCircle = circle(
    start = [
      mountHoleX + mountHoleDia / 2,
      mountHoleY
    ],
    center = [mountHoleX, mountHoleY],
  )
}

leftHoleTool = extrude(region(point = [-mountHoleX, mountHoleY], sketch = leftHoleSketch), length = t + 2mm)
rightHoleTool = extrude(region(point = [mountHoleX, mountHoleY], sketch = rightHoleSketch), length = t + 2mm)

// =====================================================================
// CUT FEATURES
// =====================================================================


baseCutLeft = subtract(baseSolid, tools = [leftHoleTool])
baseCutRight = subtract(baseCutLeft, tools = [rightHoleTool])

baseFinal = baseCutRight

// =====================================================================
// BASE FILLETS — chained sequentially on baseFinal (BEFORE the arm
// union and BEFORE the wire notch cut below), each step feeding the
// next, so the corner edge tags stay clean.
// =====================================================================


baseFillet001 = fillet(
  baseFinal,
  tags = getCommonEdge(faces = [
    baseRegion.tags.topRight,
    baseRegion.tags.ignitionRight
  ]),
  radius = filletRadius,
)
baseFillet002 = fillet(
  baseFillet001,
  tags = getCommonEdge(faces = [
    baseRegion.tags.rightChamfer,
    baseRegion.tags.topRight
  ]),
  radius = filletRadius,
)
baseFillet003 = fillet(
  baseFillet002,
  tags = getCommonEdge(faces = [
    baseRegion.tags.ignitionLeft,
    baseRegion.tags.topLeft
  ]),
  radius = filletRadius,
)
baseFillet004 = fillet(
  baseFillet003,
  tags = getCommonEdge(faces = [
    baseRegion.tags.rightSide,
    baseRegion.tags.rightChamfer
  ]),
  radius = filletRadius,
)
baseFillet005 = fillet(
  baseFillet004,
  tags = getCommonEdge(faces = [
    baseRegion.tags.topLeft,
    baseRegion.tags.leftChamfer
  ]),
  radius = filletRadius,
)
baseFillet006 = fillet(
  baseFillet005,
  tags = getCommonEdge(faces = [
    baseRegion.tags.leftChamfer,
    baseRegion.tags.leftSide
  ]),
  radius = filletRadius,
)
baseFillet007 = fillet(
  baseFillet006,
  tags = getCommonEdge(faces = [
    baseRegion.tags.leftSide,
    baseRegion.tags.bottomLeft
  ]),
  radius = filletRadius,
)
baseFillet008 = fillet(
  baseFillet007,
  tags = getCommonEdge(faces = [
    baseRegion.tags.rightSide,
    baseRegion.tags.bottomRight
  ]),
  radius = filletRadius,
)

// The wire notch is now baked directly into baseSketch above (see
// bottomLeft / wireNotch / bottomRight), so baseFillet008 already IS
// the fully-rounded, wire-notched base — no extra boolean step
// needed. Used directly in PART 3 below.


// =====================================================================
// END PART 1
// =====================================================================


// =====================================================================
// PART 2 — ARM GEOMETRY (continuous, one closed profile per arm)
// =====================================================================
// Fillets on hold here too (same reason) — sharp corners for now.


armWidth = 15mm
armHeight = 65mm
riserHeight = t + armHeight
flangeLength = 15mm
armSpacing = 65mm // matches spec: 65mm hole spacing, no change needed

// Tilt direction (unit vector, local Y,Z), 25° away from the mount
// holes / toward the headlight: sin(25°)=0.42262, cos(25°)=0.90631
tiltA = -0.42262
tiltB = 0.90631

// ---- LEFT ARM ----
armXCenterLeft = 0mm - (armSpacing / 2)

armPlaneLeft = {
  origin = [
    armXCenterLeft - (armWidth / 2),
    0mm,
    0mm
  ],
  xAxis = [0, 1, 0],
  yAxis = [0, 0, 1]
}

armSketchLeft = sketch(on = armPlaneLeft) {
  outerBase = line(start = [-3mm, 0mm], end = [-3mm, riserHeight])
  outerRelief = line(start = [-3mm, riserHeight], end = [-9.058mm, 80.327mm])
  tipCap = line(start = [-9.058mm, 80.327mm], end = [-6.339mm, 81.595mm])
  innerFlange = line(start = [-6.339mm, 81.595mm], end = [0mm, riserHeight])
  innerRiser = line(start = [0mm, riserHeight], end = [0mm, 0mm])
  baseCap = line(start = [0mm, 0mm], end = [-3mm, 0mm])

  coincident([outerBase.end, outerRelief.start])
  coincident([outerRelief.end, tipCap.start])
  coincident([tipCap.end, innerFlange.start])
  coincident([innerFlange.end, innerRiser.start])
  coincident([innerRiser.end, baseCap.start])
  coincident([baseCap.end, outerBase.start])
}

armRegionLeft = region(point = [-1.5mm, 34mm], sketch = armSketchLeft)
armSolidLeftRaw = extrude(
  armRegionLeft,
  length = armWidth,
  tagStart = $armLeftCapStart,
  tagEnd = $armLeftCapEnd,
)

// Round the two "top corners of the flange" — where the tip pad's
// end edge (tipCap) meets each of the extrusion's two width-direction
// end faces (start and end caps).
armLeftFillet001 = fillet(
  armSolidLeftRaw,
  tags = getCommonEdge(faces = [
    armRegionLeft.tags.tipCap,
    armLeftCapStart
  ]),
  radius = filletRadius,
)
armSolidLeft = fillet(
  armLeftFillet001,
  tags = getCommonEdge(faces = [
    armRegionLeft.tags.tipCap,
    armLeftCapEnd
  ]),
  radius = filletRadius,
)

// ---- POD MOUNTING HOLE (LEFT) — UPDATED: 6.5mm dia x 18mm deep ----
podHolePlaneLeft = {
  origin = [armXCenterLeft, -1.357mm, 75.643mm],
  xAxis = [1, 0, 0],
  yAxis = [0, -0.42262, 0.90631]
}

podHoleSketchLeft = sketch(on = podHolePlaneLeft) {
  podCircleLeft = circle(start = [podHoleDia / 2, 0mm], center = [0mm, 0mm])
}

podHoleToolLeft = extrude(region(point = [0mm, 0mm], sketch = podHoleSketchLeft), length = podHoleLength)
armFlangeLeftFinal = subtract(armSolidLeft, tools = [podHoleToolLeft])

// ---- RIGHT ARM (same profile, mirrored X position only) ----
armXCenterRight = armSpacing / 2

armPlaneRight = {
  origin = [
    armXCenterRight - (armWidth / 2),
    0mm,
    0mm
  ],
  xAxis = [0, 1, 0],
  yAxis = [0, 0, 1]
}

armSketchRight = sketch(on = armPlaneRight) {
  outerBaseR = line(start = [-3mm, 0mm], end = [-3mm, riserHeight])
  outerReliefR = line(start = [-3mm, riserHeight], end = [-9.058mm, 80.327mm])
  tipCapR = line(start = [-9.058mm, 80.327mm], end = [-6.339mm, 81.595mm])
  innerFlangeR = line(start = [-6.339mm, 81.595mm], end = [0mm, riserHeight])
  innerRiserR = line(start = [0mm, riserHeight], end = [0mm, 0mm])
  baseCapR = line(start = [0mm, 0mm], end = [-3mm, 0mm])

  coincident([outerBaseR.end, outerReliefR.start])
  coincident([outerReliefR.end, tipCapR.start])
  coincident([tipCapR.end, innerFlangeR.start])
  coincident([innerFlangeR.end, innerRiserR.start])
  coincident([innerRiserR.end, baseCapR.start])
  coincident([baseCapR.end, outerBaseR.start])
}

armRegionRight = region(point = [-1.5mm, 34mm], sketch = armSketchRight)
armSolidRightRaw = extrude(
  armRegionRight,
  length = armWidth,
  tagStart = $armRightCapStart,
  tagEnd = $armRightCapEnd,
)

armRightFillet001 = fillet(
  armSolidRightRaw,
  tags = getCommonEdge(faces = [
    armRegionRight.tags.tipCapR,
    armRightCapStart
  ]),
  radius = filletRadius,
)
armSolidRight = fillet(
  armRightFillet001,
  tags = getCommonEdge(faces = [
    armRegionRight.tags.tipCapR,
    armRightCapEnd
  ]),
  radius = filletRadius,
)

// ---- POD MOUNTING HOLE (RIGHT) — UPDATED: 6.5mm dia x 18mm deep ----
podHolePlaneRight = {
  origin = [armXCenterRight, -1.357mm, 75.643mm],
  xAxis = [1, 0, 0],
  yAxis = [0, -0.42262, 0.90631]
}

podHoleSketchRight = sketch(on = podHolePlaneRight) {
  podCircleRight = circle(start = [podHoleDia / 2, 0mm], center = [0mm, 0mm])
}

podHoleToolRight = extrude(region(point = [0mm, 0mm], sketch = podHoleSketchRight), length = podHoleLength)
armFlangeRightFinal = subtract(armSolidRight, tools = [podHoleToolRight])

// =====================================================================
// END PART 2
// =====================================================================


// =====================================================================
// PART 3 — FINAL ASSEMBLY
// =====================================================================


assemblyStep1 = union([baseFillet008, armFlangeLeftFinal])

mountFinal = union([assemblyStep1, armFlangeRightFinal])
  |> appearance(color = "#c9c9c9")

// =====================================================================
// END PART 3 — MANUFACTURING VERSION
// =====================================================================
// TODO measurements
